---
import BaseLayout from '@layouts/BaseLayout.astro';
import { t } from '@/lib/i18n';

const locale = 'en';
---

<BaseLayout title={t(locale, 'colophonTitle')} description="How this site is made: typography, design principles, and technology stack." locale={locale}>
  <main class="max-w-[var(--width-content)] mx-auto px-[var(--spacing-page)] py-16">
    <header class="mb-12">
      <h1>{t(locale, 'colophonTitle')}</h1>
      <p class="text-[var(--color-text-muted)] mt-2">
        {t(locale, 'colophonSubtitle')}
      </p>
    </header>

    <div class="space-y-16">
      <!-- Introduction -->
      <section>
        <p class="text-[var(--color-text-muted)]">
          {t(locale, 'colophonIntro')}
        </p>
      </section>

      <!-- Typography -->
      <section>
        <h2 class="mb-6">Typography</h2>

        <div class="space-y-6">
          <div>
            <h3 class="text-[var(--color-text-muted)] text-sm uppercase tracking-wider mb-2">Body</h3>
            <p class="text-2xl font-medium mb-2">Satoshi</p>
            <p class="text-sm text-[var(--color-text-muted)]">
              Satoshi is a sans-serif from Indian Type Foundry. Its geometric shapes stay readable even in small text.
            </p>
          </div>

          <div>
            <h3 class="text-[var(--color-text-muted)] text-sm uppercase tracking-wider mb-2">Code</h3>
            <p class="text-2xl font-mono mb-2">JetBrains Mono</p>
            <p class="text-sm text-[var(--color-text-muted)]">
              A monospace with ligatures for code. It's used here where the characters need to be easy to tell apart.
            </p>
          </div>

          <div class="pt-4 border-t border-[var(--color-border)]">
            <h3 class="text-[var(--color-text-muted)] text-sm uppercase tracking-wider mb-3">Fluid Scale</h3>
            <p class="text-sm text-[var(--color-text-muted)] mb-3">
              Text sizes follow <a href="https://utopia.fyi" target="_blank" rel="noopener noreferrer">Utopia</a>'s fluid scale. They change with screen width instead of jumping between mobile and desktop sizes.
            </p>
            <ul class="text-sm text-[var(--color-text-muted)] space-y-1">
              <li>Min viewport: <code>320px</code> @ 16px base, 1.2 ratio</li>
              <li>Max viewport: <code>1240px</code> @ 18px base, 1.25 ratio</li>
              <li>Line height: <code>1.6</code></li>
              <li>Letter spacing: <code>-0.02em</code> to <code>-0.03em</code> (headings)</li>
            </ul>
          </div>

          <div class="pt-4 border-t border-[var(--color-border)]">
            <h3 class="text-[var(--color-text-muted)] text-sm uppercase tracking-wider mb-3">Influences</h3>
            <ul class="text-sm space-y-1">
              <li><a href="https://utopia.fyi" target="_blank" rel="noopener noreferrer">Utopia</a> for fluid type and space scales</li>
              <li><a href="https://practicaltypography.com/" target="_blank" rel="noopener noreferrer">Practical Typography</a> by Matthew Butterick</li>
              <li><a href="https://fontreviewjournal.com/" target="_blank" rel="noopener noreferrer">Font Review Journal</a> by Bethany Heck</li>
              <li><em>The Elements of Typographic Style</em> by Robert Bringhurst</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Design -->
      <section>
        <h2 class="mb-6">Design</h2>

        <div class="space-y-6">
          <div>
            <h3 class="text-[var(--color-text-muted)] text-sm uppercase tracking-wider mb-3">Principles</h3>
            <ul class="text-sm text-[var(--color-text-muted)] space-y-2">
              <li>Text first, few ornaments</li>
              <li>Black and white, no accent color</li>
              <li>Light and dark modes</li>
              <li>Underlined links, a slight glow on hover in dark mode</li>
            </ul>
          </div>

          <div class="pt-4 border-t border-[var(--color-border)]">
            <h3 class="text-[var(--color-text-muted)] text-sm uppercase tracking-wider mb-3">Colors</h3>
            <div class="grid grid-cols-2 gap-4 text-sm">
              <div>
                <p class="font-medium mb-2">Light</p>
                <ul class="text-[var(--color-text-muted)] space-y-1">
                  <li>Background: <code>#fcfcfc</code></li>
                  <li>Text: <code>#202020</code></li>
                  <li>Muted: <code>#6b6b6b</code></li>
                </ul>
              </div>
              <div>
                <p class="font-medium mb-2">Dark</p>
                <ul class="text-[var(--color-text-muted)] space-y-1">
                  <li>Background: <code>#141414</code></li>
                  <li>Text: <code>#f0f0f0</code></li>
                  <li>Muted: <code>#8a8a8a</code></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Technology -->
      <section>
        <h2 class="mb-6">Technology</h2>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <tbody class="divide-y divide-[var(--color-border)]">
              <tr>
                <td class="py-3 pr-4 text-[var(--color-text-muted)]">Framework</td>
                <td class="py-3"><a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></td>
              </tr>
              <tr>
                <td class="py-3 pr-4 text-[var(--color-text-muted)]">Styling</td>
                <td class="py-3"><a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer">Tailwind CSS</a></td>
              </tr>
              <tr>
                <td class="py-3 pr-4 text-[var(--color-text-muted)]">Content</td>
                <td class="py-3"><a href="https://mdxjs.com" target="_blank" rel="noopener noreferrer">MDX</a></td>
              </tr>
              <tr>
                <td class="py-3 pr-4 text-[var(--color-text-muted)]">Backend</td>
                <td class="py-3"><a href="https://convex.dev" target="_blank" rel="noopener noreferrer">Convex</a></td>
              </tr>
              <tr>
                <td class="py-3 pr-4 text-[var(--color-text-muted)]">Hosting</td>
                <td class="py-3"><a href="https://vercel.com" target="_blank" rel="noopener noreferrer">Vercel</a></td>
              </tr>
              <tr>
                <td class="py-3 pr-4 text-[var(--color-text-muted)]">Audio</td>
                <td class="py-3"><a href="https://elevenlabs.io" target="_blank" rel="noopener noreferrer">ElevenLabs</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Weather Avatar -->
      <section>
        <h2 class="mb-6">Weather Avatar</h2>

        <div class="space-y-4">
          <p class="text-sm text-[var(--color-text-muted)]">
            The avatar follows the current weather. It uses <a href="https://github.com/bKNNNNN/skyface" target="_blank" rel="noopener noreferrer">Skyface</a> to generate and display the variants.
          </p>
          <div class="pt-4 border-t border-[var(--color-border)]">
            <h3 class="text-[var(--color-text-muted)] text-sm uppercase tracking-wider mb-3">How it works</h3>
            <ul class="text-sm text-[var(--color-text-muted)] space-y-2">
              <li>Weather data from <a href="https://api.meteo-france.com" target="_blank" rel="noopener noreferrer">Météo France API</a></li>
              <li>Up to 45 variants generated with <a href="https://deepmind.google/technologies/gemini/" target="_blank" rel="noopener noreferrer">Gemini</a></li>
              <li>9 weather conditions: sunny, cloudy, rain, snow, fog, thunderstorm, wind, clear night, cloudy night</li>
              <li>Up to 5 variants per condition</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Tools -->
      <section>
        <h2 class="mb-6">Tools</h2>

        <ul class="text-sm text-[var(--color-text-muted)] space-y-2">
          <li>Editor: <a href="https://www.anthropic.com/claude-code" target="_blank" rel="noopener noreferrer">Claude Code</a></li>
          <li>Terminal: Bash</li>
          <li>Version control: Git + GitHub</li>
        </ul>
      </section>

      <!-- Accessibility & Performance -->
      <section>
        <h2 class="mb-6">Accessibility & Performance</h2>

        <ul class="text-sm text-[var(--color-text-muted)] space-y-2">
          <li>Respects <code>prefers-reduced-motion</code></li>
          <li>No trackers, no analytics</li>
          <li>Optimized images</li>
          <li>Variable fonts to reduce weight</li>
        </ul>
      </section>

      <!-- Open Source -->
      <section>
        <h2 class="mb-6">Open Source</h2>

        <p class="text-sm text-[var(--color-text-muted)]">
          The source code for this site is available on <a href="https://github.com/bKNNNNN/personal-website" target="_blank" rel="noopener noreferrer">GitHub</a>.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>
