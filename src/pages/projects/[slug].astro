---
// Renders the case study directly instead of rewriting like /now: with i18n
// domains, a rewrite to the dynamic /fr/projects/[slug] route fails on
// pierrickdeniel.fr in production.
import ProjectCase from '@components/ui/ProjectCase.astro';
import { findProject } from '@/lib/projects';

const host = Astro.request.headers.get('host') || '';
const locale = host.includes('pierrickdeniel.fr') ? 'fr' : 'en';
const project = findProject(Astro.params.slug);
if (!project) {
  return new Response(null, { status: 404 });
}
---

<ProjectCase project={project} locale={locale} />
